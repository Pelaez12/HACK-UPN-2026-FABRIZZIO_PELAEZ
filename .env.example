# ========================================================
# Ellie Life Enterprise — Variables de Entorno (Plantilla)
# IMPORTANTE: Nunca coloques claves reales en este archivo.
# Copia este archivo a .env y asigna los valores en tu entorno seguro.
# ========================================================

# Puerto local del servidor
PORT=4173

# Integración con DeepSeek (Solo en backend)
DEEPSEEK_API_KEY=tu_clave_api_deepseek_aqui
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Integración con Supabase (PostgreSQL + PostGIS)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_clave_anon_publica_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_clave_service_role_solo_backend_aqui

# Gateway de Notificaciones Push / SMS (Configurable)
NOTIFICATION_GATEWAY_URL=https://api.tu-gateway.com/v1/notify
NOTIFICATION_GATEWAY_TOKEN=tu_token_de_gateway_aqui
